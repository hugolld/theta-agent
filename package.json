{
	"name": "theta-agent",
	"version": "0.3.0",
	"description": "Theta — a science co-researcher agent built as a package for the pi coding agent harness",
	"keywords": [
		"pi",
		"pi-package",
		"pi-agent",
		"agent",
		"science",
		"research",
		"co-scientist",
		"scientific-computing",
		"bioinformatics",
		"agent-skills"
	],
	"license": "MIT",
	"type": "module",
	"bin": {
		"theta": "./bin/theta.mjs"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hugolld/theta-agent.git"
	},
	"files": [
		"bin/",
		"extensions/",
		"skills/",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": ["./extensions"],
		"skills": ["./skills"]
	},
	"scripts": {
		"lint": "eslint .",
		"lint:dups": "npx --yes jscpd@5.4.1 --min-tokens 50 --ignore \"**/fixtures/**,**/.venv/**,**/uv.lock\" --threshold 6 --reporters console scripts test bin extensions gateway",
		"lint:py": "uvx ruff@0.15.7 check skills/theta-lit-search/scripts skills/theta-notebook/scripts gateway/theta_compute",
		"test": "node --test",
		"rig": "node test/rig/run.mjs",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@types/node": "^26.6.3",
		"eslint": "^10.11.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"yaml": "^2.9.1"
	},
	"engines": {
		"node": ">=22"
	}
}
