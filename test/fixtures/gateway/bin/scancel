#!/usr/bin/env python3
"""Stub scancel for the gateway boundary tests: record, then answer.

Exits 0 for every job id except the scripted failure:

	666001  a scancel-side failure — exit 1 with a stderr line

When THETA_GATEWAY_STUB_ARGV names a file, every invocation appends one
NUL-separated argv group, exactly as the sinfo stub does.
"""

import os
import sys

FAILING_ID = "666001"


def requested_job(argv):
	if len(argv) > 1:
		return argv[-1]
	return ""


def main():
	log = os.environ.get("THETA_GATEWAY_STUB_ARGV")
	if log:
		with open(log, "ab") as handle:
			handle.write(b"\0".join(os.fsencode(arg) for arg in sys.argv) + b"\n")
	job = requested_job(sys.argv)
	if job == FAILING_ID:
		sys.stderr.write("scancel: error: Invalid job id specified\n")
		sys.exit(1)
	sys.stdout.write("")


if __name__ == "__main__":
	main()
