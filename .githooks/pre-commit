#!/bin/bash
# Local guardrail mirroring the verify workflow: block commits on a stale
# gateway lock, a red suite, or red lint (JS via eslint, self-authored
# Python via ruff — vendored skill trees stay verbatim and out of scope).
# Unset the env git exports to hooks — fixture repos in the suite must not
# commit into this repository. The suite's full TAP output runs long; keep
# the tail summary only (a red run re-runs `npm test` for the failure
# detail) so every commit stays cheap to read.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY
# A pipeline's failing head must fail the hook (lint:sh, #139) — the tail
# summary must never mask a red suite.
set -o pipefail
# A stale gateway lock fails the suite as nine servers that never listen —
# name the cause first (S1's version bump staled it exactly that way).
(cd gateway && uv lock --check) || exit 1
npm run lint:py --silent
out=$(npm test --silent)
status=$?
printf '%s\n' "$out" | tail -n 12
if [ "$status" -ne 0 ]; then
	# The hook runs the suite against the working tree, not the staged index
	# (the #133 retro): a partially-staged commit refused and the cause was
	# re-derived from scratch. Name it where the failure lands.
	echo "pre-commit: the hook tests the working tree, not the staged index — an unstaged red file refuses a commit whose staged content is green" >&2
fi
exit $status
